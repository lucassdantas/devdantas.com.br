# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.

# --- Públicas (vão para o navegador) ---
# WhatsApp: DDI + DDD + número, só dígitos (ex.: 5521999999999)
NEXT_PUBLIC_WHATSAPP=
# Cloudflare → Turnstile → seu widget → Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Secretas (só a função api/orcamento.ts lê; nunca vão para o navegador) ---
# Final de https://formspree.io/f/SEU_ID
FORMSPREE_FORM_ID=
# Cloudflare → Turnstile → seu widget → Secret Key
TURNSTILE_SECRET_KEY=
