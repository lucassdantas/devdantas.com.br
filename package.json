{
  "name": "dantas-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project components",
    "test:watch": "vitest --project unit --project components",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:integration && npm run test:e2e",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^30.1.3",
    "opentype.js": "2.0.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
